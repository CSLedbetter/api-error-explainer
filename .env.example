# Server-side only. Set these in Vercel > Project > Settings > Environment Variables.

# A dedicated Claude API key for this demo (ideally in its own Console workspace with a spend limit).
ANTHROPIC_API_KEY=

# Shared Supabase project that holds the access codes and the $15 spend cap.
SUPABASE_URL=https://floagxzbvqxrscnqotyn.supabase.co
# Secret key (Project Settings > API Keys). Never put this in the browser.
SUPABASE_SECRET_KEY=

# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=

# The only signed-in email that can open /admin and approve people.
ADMIN_EMAIL=
